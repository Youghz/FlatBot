# Database (docker compose up -d db)
DATABASE_URL=postgresql://flatbot:flatbot@localhost:5432/flatbot

# JWT secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_to_a_random_string

# Telegram Bot API token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Secret token for Telegram webhook verification (set via setWebhook API)
TELEGRAM_WEBHOOK_SECRET=

# Rentals.ca GraphQL API key
RENTALS_GQL_KEY=your_rentals_api_key_here
